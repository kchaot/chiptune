{
    "name": "kchaot/chiptune",
    "type": "project",
    "require": {
        "php": "^8.5.12",
        "ext-dom": "*",
        "ext-json": "*",
        "matthiasmullie/minify": "^1.3",
        "tempest/markdown": "dev-Multi-Content-PR"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/ek9r/markdown_dev" }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "Chiptune\\": "lib/" }
    },
    "scripts": {
        "fmt": "mago fmt",
        "fmt:check": "mago fmt --check",
        "lint": "mago lint",
        "analyse": "mago analyze",
        "build": "php bin/build.php --local-only",
        "compare": "php bin/compare.php",
        "docs": "php bin/docs.php",
        "docs:check": "php bin/docs.php --check",
        "qa": [
            "@fmt:check",
            "@lint",
            "@analyse",
            "@docs:check",
            "@build"
        ]
    },
    "config": {
        "vendor-dir": "opt/packagist",
        "sort-packages": true
    },
    "require-dev": {
        "carthage-software/mago": "^1.58.2"
    }
}
